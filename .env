# ── Helius (free at helius.dev) ──────────────────────────────

=YOUR_HELIUS_API_KEY

# ── Phantom Wallet (your public key only — never paste private key here) ──
PHANTOM_PUBLIC_KEY=YOUR_PHANTOM_PUBLIC_KEY

# ── Telegram (create bot via @BotFather, get chat id via @userinfobot) ────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── Alert settings ────────────────────────────────────────────
MIN_SOL_THRESHOLD=20        # minimum SOL value to trigger alert
POLL_INTERVAL_MS=8000       # how often to poll (ms)

# ── GMGN settings ─────────────────────────────────────────────
GMGN_REFRESH_HOURS=6        # how often to refresh whale wallet list
GMGN_WALLET_LIMIT=20        # how many top wallets to track
